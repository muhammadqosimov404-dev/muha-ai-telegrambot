async def question(q,ctx):
 i=ctx.user_data["idx"];items=ctx.user_data["items"];s=ctx.user_data["subject"]
 if i>=len(items):
  n=ctx.user_data["correct"];total=len(items);uid=q.from_user.id
  with db() as c:
   c.execute("INSERT INTO results(uid,subject,correct,total,created_at) VALUES(?,?,?,?,?)",(uid,s,n,total,datetime.now(timezone.utc).isoformat()))
   c.execute("UPDATE users SET score=score+?,total=total+? WHERE uid=?",(n,total,uid))
  await q.edit_message_text(f"Test yakunlandi: {s}\\nNatija: {n}/{total}",reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("Yana test",callback_data="subjects")],[InlineKeyboardButton("Profil",callback_data="profile")]]));return
 text,opts,correct,ex=items[i]
 await q.edit_message_text(f"🎓 {s} — {i+1}/{len(items)}\\n\\n{text}",reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton(f"{'ABCD'[j]}. {o}",callback_data=f"answer|{j}|{i}")] for j,o in enumerate(opts)]))
async def ai_reply(text, image_url=None):
 if not OPENAI_API_KEY:return "AI xizmatini yoqish uchun Railway Variables ichida OPENAI_API_KEY kiriting."
 try:
  from openai import OpenAI
  client=OpenAI(api_key=OPENAI_API_KEY)
  content=[{"type":"text","text":text}]
  if image_url:content.append({"type":"image_url","image_url":{"url":image_url}})
  r=client.chat.completions.create(model=AI_MODEL,messages=[{"role":"system","content":"You are MUHA AI, a helpful educational assistant. Reply in the user's language, explain steps clearly, and do not claim practice questions are official exam questions."},{"role":"user","content":content}],max_tokens=900)
  return r.choices[0].message.content or "Javob bo‘sh qaytdi."
 except Exception as e:
  logging.exception("AI request failed")
  return "AI xizmatida xatolik yuz berdi. API kaliti, balans va model sozlamalarini tekshiring."
