async def makecode(u,c):
 if u.effective_user.id not in ADMIN_IDS:await u.effective_message.reply_text("Faqat administrator uchun.");return
 try:credits=int(c.args[0]) if c.args else PREMIUM_CREDITS;months=int(c.args[1]) if len(c.args)>1 else 5
 except:await u.effective_message.reply_text("Format: /makecode 5000 5");return
 code=os.urandom(5).hex().upper()
 with db() as x:x.execute("INSERT INTO codes VALUES(?,?,?,?,?)",(code,credits,months,None,u.effective_user.id))
 await u.effective_message.reply_text(f"Bir martalik kod: {code}\\nKredit: {credits}\\nPremium: {months} oy")
async def redeem(u,c):
 uid=u.effective_user.id;ensure(uid)
 if not c.args:await u.effective_message.reply_text("Format: /redeem KOD");return
 code=c.args[0].upper()
 with db() as x:
  row=x.execute("SELECT credits,months,used_by FROM codes WHERE code=?",(code,)).fetchone()
  if not row or row[2] is not None:await u.effective_message.reply_text("Kod noto‘g‘ri yoki ishlatilgan.");return
  credits,months,_=row;now=datetime.now(timezone.utc);old=x.execute("SELECT premium_until FROM users WHERE uid=?",(uid,)).fetchone()[0]
  try:
   olddt=datetime.fromisoformat(old) if old else now
   if olddt>now:now=olddt
  except:pass
  m=now.month-1+months;y=now.year+m//12;m=m%12+1;d=min(now.day,calendar.monthrange(y,m)[1]);exp=now.replace(year=y,month=m,day=d).isoformat()
  x.execute("UPDATE codes SET used_by=? WHERE code=?",(uid,code))
  x.execute("UPDATE users SET credits=credits+?,premium_until=? WHERE uid=?",(credits,exp,uid))
 await u.effective_message.reply_text(f"Kod qabul qilindi. {credits} kredit, Premium {months} oy. Tugash: {exp[:10]}")
def main():
 if not TOKEN:raise RuntimeError("TELEGRAM_BOT_TOKEN environment variable is missing")
 a=Application.builder().token(TOKEN).build()
 for cmd,fn in [("start",start),("help",help_cmd),("mode",mode),("profile",profile),("usage",usage),("reset",reset),("makecode",makecode),("redeem",redeem)]:a.add_handler(CommandHandler(cmd,fn))
 a.add_handler(CallbackQueryHandler(cb))
 a.add_handler(MessageHandler(filters.PHOTO,photo_msg))
 a.add_handler(MessageHandler(filters.VOICE,voice_msg))
 a.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND,text_msg))
 a.run_polling()
if __name__=="__main__":main()
