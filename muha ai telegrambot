async def voice_msg(u:Update,ctx:ContextTypes.DEFAULT_TYPE):
 if not OPENAI_API_KEY:
  await u.effective_message.reply_text("Ovozni matnga aylantirish uchun OPENAI_API_KEY sozlang.");return
 try:
  from openai import OpenAI
  f=await u.effective_message.voice.get_file()
  data=await f.download_as_bytearray()
  client=OpenAI(api_key=OPENAI_API_KEY)
  with tempfile.NamedTemporaryFile(suffix=".ogg") as tmp:
   tmp.write(data);tmp.flush()
   tr=client.audio.transcriptions.create(model=TRANSCRIBE_MODEL,file=open(tmp.name,"rb"))
  await u.effective_message.reply_text("🎙 Tanilgan matn:\\n"+tr.text)
  await u.effective_message.reply_text(await ai_reply(tr.text))
 except Exception:
  logging.exception("Voice handler failed");await u.effective_message.reply_text("Ovoz tahlilida xatolik. API sozlamalarini tekshiring.")
