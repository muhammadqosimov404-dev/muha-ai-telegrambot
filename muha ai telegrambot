 elif q.data=="official":await q.edit_message_text("UZBMB rasmiy manbalari:\\nhttps://uzbmb.uz/page/milliytest\\nhttps://www.uzbmb.uz/page/namuna_m\\nhttps://www.uzbmb.uz/page/fanlar\\n\\nBot savollari rasmiy savollar emas.",reply_markup=home())
 elif q.data=="profile":
  with db() as c:
   r=c.execute("SELECT credits,premium_until,score,total,daily_used FROM users WHERE uid=?",(uid,)).fetchone()
