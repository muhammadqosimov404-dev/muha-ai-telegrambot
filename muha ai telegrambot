def db():
 c=sqlite3.connect(DB_PATH)
 c.execute("""CREATE TABLE IF NOT EXISTS users(uid INTEGER PRIMARY KEY,credits INTEGER DEFAULT 0,premium_until TEXT,daily_date TEXT,daily_used INTEGER DEFAULT 0,score INTEGER DEFAULT 0,total INTEGER DEFAULT 0)""")
 c.execute("CREATE TABLE IF NOT EXISTS codes(code TEXT PRIMARY KEY,credits INTEGER,months INTEGER,used_by INTEGER,created_by INTEGER)")
 c.execute("CREATE TABLE IF NOT EXISTS results(id INTEGER PRIMARY KEY,uid INTEGER,subject TEXT,correct INTEGER,total INTEGER,created_at TEXT)")
 return c
def active(exp):
 try:return bool(exp and datetime.fromisoformat(exp)>datetime.now(timezone.utc))
 except:return False
def ensure(uid):
 with db() as c:c.execute("INSERT OR IGNORE INTO users(uid) VALUES(?)",(uid,))
def consume(uid):
 ensure(uid); today=datetime.now(timezone.utc).date().isoformat()
 with db() as c:
  r=c.execute("SELECT credits,premium_until,daily_date,daily_used FROM users WHERE uid=?",(uid,)).fetchone()
  credits,exp,day,used=r
  if credits>0:
   c.execute("UPDATE users SET credits=credits-1 WHERE uid=?",(uid,));return True
  if active(exp):return True
  if day!=today:day=today;used=0
  if used>=DAILY_LIMIT:return False
  c.execute("UPDATE users SET daily_date=?,daily_used=? WHERE uid=?",(day,used+1,uid))
  return True
